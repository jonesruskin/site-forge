# dependencies
node_modules/

# builds
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo
next-env.d.ts

# env — never commit secrets; only .env.example is tracked
.env*
!.env.example

# tests
coverage/
test-results/
playwright-report/
blob-report/

# misc
.DS_Store
*.log
.vercel/
.pglite/

# playground is generated by `pnpm playground:sync`; only the demo overlay is committed
apps/playground/*
!apps/playground/demo/
