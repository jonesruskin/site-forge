{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Unique kebab-case identifier."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "category": {
      "type": "string",
      "enum": [
        "seo-ops",
        "content",
        "marketing",
        "saas",
        "portfolio",
        "commerce",
        "infrastructure",
        "developer"
      ]
    },
    "requires": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$",
        "description": "Unique kebab-case identifier."
      }
    },
    "conflicts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$",
        "description": "Unique kebab-case identifier."
      }
    },
    "ui": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$",
        "description": "Unique kebab-case identifier."
      }
    },
    "sections": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$",
        "description": "Unique kebab-case identifier."
      }
    },
    "files": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "from",
              "to"
            ]
          }
        ]
      }
    },
    "dependencies": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "devDependencies": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "env": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "default": false,
            "type": "boolean"
          },
          "scope": {
            "default": "server",
            "type": "string",
            "enum": [
              "server",
              "client",
              "shared"
            ]
          },
          "example": {
            "default": "",
            "type": "string"
          },
          "howTo": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "description"
        ]
      }
    },
    "envFile": {
      "type": "string",
      "minLength": 1
    },
    "dbSchema": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "slots": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$",
        "description": "Unique kebab-case identifier."
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "export": {
            "type": "string",
            "pattern": "^[a-zA-Z_$][\\w$]*$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "typeImports": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "file",
          "export",
          "type",
          "description"
        ]
      }
    },
    "contributes": {
      "default": {},
      "type": "object",
      "properties": {
        "slots": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "Unique kebab-case identifier."
              },
              "import": {
                "type": "string",
                "pattern": "^[a-zA-Z_$][\\w$]*$"
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "order": {
                "default": 100,
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "slot",
              "import",
              "from"
            ]
          }
        },
        "next": {
          "default": {},
          "type": "object",
          "properties": {
            "serverExternalPackages": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "imageRemotePatterns": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "protocol": {
                    "type": "string",
                    "enum": [
                      "http",
                      "https"
                    ]
                  },
                  "hostname": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pathname": {
                    "type": "string"
                  }
                },
                "required": [
                  "hostname"
                ]
              }
            },
            "csp": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "nav": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "location": {
                "type": "string",
                "enum": [
                  "header",
                  "footer",
                  "legal",
                  "dashboard",
                  "settings",
                  "admin"
                ]
              },
              "group": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "href": {
                "type": "string",
                "minLength": 1
              },
              "icon": {
                "type": "string"
              }
            },
            "required": [
              "location",
              "label",
              "href"
            ]
          }
        },
        "siteConfig": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "features": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "scripts": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "gitignore": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowBuilds": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "routes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "postInstall": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "version",
    "title",
    "description",
    "category",
    "files"
  ]
}
