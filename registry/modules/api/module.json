{
  "$schema": "../../schema/module.schema.json",
  "name": "api",
  "version": "1.0.0",
  "title": "Public API",
  "description": "Hashed API keys with scopes and expiry, an apiRoute() helper (auth, Zod validation, rate limits, problem+json errors), /api/v1/me and an API keys settings tab.",
  "category": "developer",
  "requires": ["auth", "database", "rate-limit", "settings"],
  "ui": [
    "button",
    "input",
    "field",
    "card",
    "badge",
    "checkbox",
    "label",
    "native-select",
    "table",
    "alert",
    "copy-button"
  ],
  "sections": ["empty-state"],
  "files": [
    "src/db/schema/api.ts",
    "src/lib/api/config.ts",
    "src/lib/api/keys.ts",
    "src/lib/api/route.ts",
    "src/lib/api/actions.ts",
    "src/lib/api/onboarding.ts",
    "src/components/api/create-key-form.tsx",
    "src/components/api/key-list.tsx",
    "src/app/(app)/settings/api-keys/page.tsx",
    "src/app/api/v1/me/route.ts"
  ],
  "dbSchema": ["src/db/schema/api.ts"],
  "contributes": {
    "slots": [
      {
        "slot": "onboarding-tasks",
        "import": "apiOnboardingTask",
        "from": "src/lib/api/onboarding.ts",
        "order": 40
      }
    ],
    "nav": [
      {
        "location": "settings",
        "label": "API keys",
        "href": "/settings/api-keys",
        "icon": "key-round"
      }
    ],
    "siteConfig": {
      "api": {
        "keyPrefix": "sk",
        "scopes": {
          "read": "Read your account data",
          "write": "Create and change data"
        },
        "rateLimit": { "limit": 60, "window": "1 m" }
      }
    }
  },
  "routes": ["/settings/api-keys", "/api/v1/me"],
  "postInstall": [
    "Create a key at /settings/api-keys, then: curl -H \"Authorization: Bearer <key>\" <site>/api/v1/me",
    "New endpoint: export const GET = apiRoute({ scope: \"read\" }, async ({ principal }) => ({ … })) in src/app/api/v1/<name>/route.ts."
  ]
}
