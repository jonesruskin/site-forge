{
  "$schema": "../../schema/module.schema.json",
  "name": "projects",
  "version": "1.0.0",
  "title": "Projects",
  "description": "Portfolio projects in MDX: filterable grid, detail pages with role, stack, links and a photo strip, prev/next navigation and per-project OG images.",
  "category": "portfolio",
  "requires": ["mdx", "seo"],
  "ui": ["prose", "badge", "button"],
  "sections": ["project-grid", "page-header"],
  "files": [
    "content/projects/field-notes.mdx",
    "content/projects/tide-tables.mdx",
    "src/lib/projects/projects.ts",
    "src/components/projects/tag-filter.tsx",
    "src/app/(site)/projects/page.tsx",
    "src/app/(site)/projects/tags/[tag]/page.tsx",
    "src/app/(site)/projects/[slug]/page.tsx",
    "src/app/(site)/projects/[slug]/opengraph-image.tsx"
  ],
  "contributes": {
    "slots": [
      { "slot": "sitemap", "import": "projectsSitemap", "from": "src/lib/projects/projects.ts" }
    ],
    "nav": [{ "location": "header", "label": "Projects", "href": "/projects" }],
    "siteConfig": {
      "projects": { "title": "Projects", "description": "Things I've designed, built and shipped." }
    }
  },
  "routes": ["/projects", "/projects/tags/[tag]", "/projects/[slug]"],
  "postInstall": [
    "Add projects as content/projects/<slug>.mdx; the two examples show every frontmatter field."
  ]
}
