{
  "$schema": "../../schema/module.schema.json",
  "name": "teams",
  "version": "1.2.0",
  "title": "Teams",
  "description": "Organizations with roles (owner, admin, member), email invitations, team switcher and team settings, on Better Auth's organization plugin.",
  "category": "saas",
  "requires": ["auth", "dashboard", "database", "email"],
  "ui": [
    "button",
    "input",
    "field",
    "card",
    "badge",
    "dropdown-menu",
    "dialog",
    "native-select",
    "alert",
    "avatar"
  ],
  "sections": ["empty-state"],
  "files": [
    "src/db/schema/teams.ts",
    "src/lib/teams/auth-plugin.ts",
    "src/lib/teams/auth-client-plugin.ts",
    "src/lib/teams/queries.ts",
    "src/lib/teams/actions.ts",
    "src/components/teams/team-switcher.tsx",
    "src/components/teams/team-switcher-slot.tsx",
    "src/components/teams/create-team-dialog.tsx",
    "src/components/teams/invite-form.tsx",
    "src/components/teams/team-form.tsx",
    "src/components/teams/team-widget.tsx",
    "src/emails/team-invite.tsx",
    "src/app/(app)/settings/team/page.tsx",
    "src/app/(app)/invite/[id]/page.tsx",
    "src/lib/teams/onboarding.ts"
  ],
  "dbSchema": ["src/db/schema/teams.ts"],
  "contributes": {
    "slots": [
      {
        "slot": "auth-plugins",
        "import": "teamsPlugin",
        "from": "src/lib/teams/auth-plugin.ts"
      },
      {
        "slot": "auth-client-plugins",
        "import": "teamsClientPlugin",
        "from": "src/lib/teams/auth-client-plugin.ts"
      },
      {
        "slot": "dashboard-topbar",
        "import": "TeamSwitcherSlot",
        "from": "src/components/teams/team-switcher-slot.tsx",
        "order": 10
      },
      {
        "slot": "dashboard-widgets",
        "import": "TeamWidget",
        "from": "src/components/teams/team-widget.tsx",
        "order": 20
      },
      {
        "slot": "email-templates",
        "import": "TeamInviteEmail",
        "from": "src/emails/team-invite.tsx"
      },
      {
        "slot": "onboarding-tasks",
        "import": "teamsOnboardingTask",
        "from": "src/lib/teams/onboarding.ts",
        "order": 30
      }
    ],
    "nav": [
      {
        "location": "settings",
        "label": "Team",
        "href": "/settings/team",
        "icon": "users"
      }
    ],
    "siteConfig": {
      "teams": {
        "membershipLimit": 50,
        "invitationExpiresInDays": 7
      }
    }
  },
  "routes": ["/settings/team", "/invite/[id]"],
  "postInstall": [
    "Create a team from the switcher in the top bar. Invitations are emailed (see /dev/outbox in development)."
  ]
}
