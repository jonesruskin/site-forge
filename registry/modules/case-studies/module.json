{
  "$schema": "../../schema/module.schema.json",
  "name": "case-studies",
  "version": "1.0.0",
  "title": "Case studies",
  "description": "Customer stories in MDX with client, industry, services and headline results; grid index and story pages.",
  "category": "content",
  "requires": ["mdx", "seo"],
  "ui": ["prose"],
  "sections": ["project-grid", "page-header", "stats"],
  "files": [
    "content/case-studies/example.mdx",
    "src/lib/case-studies/case-studies.ts",
    "src/app/(site)/case-studies/page.tsx",
    "src/app/(site)/case-studies/[slug]/page.tsx",
    "src/app/(site)/case-studies/[slug]/opengraph-image.tsx"
  ],
  "contributes": {
    "slots": [
      {
        "slot": "sitemap",
        "import": "caseStudiesSitemap",
        "from": "src/lib/case-studies/case-studies.ts"
      }
    ],
    "nav": [{ "location": "header", "label": "Work", "href": "/case-studies" }],
    "siteConfig": {
      "caseStudies": { "title": "Case studies", "description": "How we helped teams like yours." }
    }
  },
  "routes": ["/case-studies", "/case-studies/[slug]"],
  "postInstall": ["Replace content/case-studies/example.mdx with real stories."]
}
