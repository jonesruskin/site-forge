# Generated by site-forge from module manifests. Copy to .env.local and fill in.
# Variables marked (required) must be set in production; in development every
# module falls back to a safe local behavior when they are missing.

# ─── core ──────────────────────────────────────────────────────────────────
# Canonical public URL of the site, no trailing slash. Falls back to the url in site.config.ts
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── email ─────────────────────────────────────────────────────────────────
# Resend API key. Without it (in development) emails are saved to the local outbox (required)
# → https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Default sender, on a domain verified in Resend (required)
# → https://resend.com/domains
EMAIL_FROM=Acme <hello@acme.com>

# ─── rate-limit ────────────────────────────────────────────────────────────
# Upstash Redis REST URL. Without it, limits are kept in memory (per server instance)
# → https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# Upstash Redis REST token
# → Same page as the URL
UPSTASH_REDIS_REST_TOKEN=

# ─── contact ───────────────────────────────────────────────────────────────
# Inbox that receives contact form submissions (required)
CONTACT_TO_EMAIL=hello@example.com
# Cloudflare Turnstile site key. Set both Turnstile keys to add an invisible challenge
# → https://dash.cloudflare.com → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret key
TURNSTILE_SECRET_KEY=
