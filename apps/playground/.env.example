# Generated by site-forge from module manifests. Copy to .env.local and fill in.
# Variables marked (required) must be set in production; in development every
# module falls back to a safe local behavior when they are missing.

# ─── core ──────────────────────────────────────────────────────────────────
# Canonical public URL of the site, no trailing slash. Falls back to the url in site.config.ts
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── database ──────────────────────────────────────────────────────────────
# Postgres connection string. Unset in development = embedded PGlite in .site/dev/pglite (required)
# → Neon: console.neon.tech → Connection string (pooled). Supabase: Project settings → Database → Transaction pooler
DATABASE_URL=postgres://user:password@host:5432/db?sslmode=require

# ─── email ─────────────────────────────────────────────────────────────────
# Resend API key. Without it (in development) emails are saved to the local outbox (required)
# → https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Default sender, on a domain verified in Resend (required)
# → https://resend.com/domains
EMAIL_FROM=Acme <hello@acme.com>
# Set to 1 to capture every email in the outbox instead of sending (previews, staging, CI). /dev/outbox then works in production builds too
EMAIL_OUTBOX=

# ─── rate-limit ────────────────────────────────────────────────────────────
# Upstash Redis REST URL. Without it, limits are kept in memory (per server instance)
# → https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# Upstash Redis REST token
# → Same page as the URL
UPSTASH_REDIS_REST_TOKEN=

# ─── auth ──────────────────────────────────────────────────────────────────
# Secret for signing sessions and tokens (32+ random characters) (required)
# → openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL for auth callbacks. Defaults to the site URL in production and the request origin in development
BETTER_AUTH_URL=https://example.com
# Google OAuth client ID (enables “Continue with Google”)
# → console.cloud.google.com → APIs & Services → Credentials; redirect URI: <site>/api/auth/callback/google
GOOGLE_CLIENT_ID=
# Google OAuth client secret
GOOGLE_CLIENT_SECRET=
# GitHub OAuth app client ID (enables “Continue with GitHub”)
# → github.com/settings/developers → OAuth Apps; callback: <site>/api/auth/callback/github
GITHUB_CLIENT_ID=
# GitHub OAuth app client secret
GITHUB_CLIENT_SECRET=

# ─── admin ─────────────────────────────────────────────────────────────────
# Comma-separated emails that are promoted to admin the first time they open /admin
ADMIN_EMAILS=you@example.com

# ─── analytics ─────────────────────────────────────────────────────────────
# Enables Plausible (cookieless) for this domain
# → https://plausible.io/sites
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Script URL for self-hosted Plausible (default https://plausible.io/js/script.js)
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Enables PostHog (project API key, phc_…)
# → PostHog → Project settings → Project API key
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingest host
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Enables Google Analytics 4 (G-XXXXXXX)
# → GA → Admin → Data streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Enables Umami (cookieless)
# → Umami → Settings → Websites
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Umami script URL (default Umami Cloud)
NEXT_PUBLIC_UMAMI_SRC=

# ─── payments ──────────────────────────────────────────────────────────────
# Stripe secret key. Unset in development = mock provider with a fake checkout at /dev/checkout (required)
# → https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_…
# Signing secret of the webhook endpoint <site>/api/payments/webhook (required)
# → Dashboard → Developers → Webhooks, or `stripe listen --forward-to localhost:3000/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=whsec_…

# ─── contact ───────────────────────────────────────────────────────────────
# Inbox that receives contact form submissions (required)
CONTACT_TO_EMAIL=hello@example.com
# Cloudflare Turnstile site key. Set both Turnstile keys to add an invisible challenge
# → https://dash.cloudflare.com → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret key
TURNSTILE_SECRET_KEY=

# ─── feature-flags ─────────────────────────────────────────────────────────
# Force flags on or off for everyone without a code change, e.g. "newCheckout=off,betaBanner=on"
FLAG_OVERRIDES=

# ─── maintenance ───────────────────────────────────────────────────────────
# "on" shows the maintenance page to everyone (except bypass holders)
MAINTENANCE_MODE=off
# Visit any URL with ?maintenance=<token> to browse normally during maintenance
# → openssl rand -hex 16
MAINTENANCE_BYPASS_TOKEN=
# Scheduled window as start/end ISO times; announced 72h ahead, enforced while it lasts
NEXT_PUBLIC_MAINTENANCE_WINDOW=2026-10-01T02:00:00Z/2026-10-01T03:00:00Z

# ─── newsletter ────────────────────────────────────────────────────────────
# Where subscribers are stored: resend, buttondown or kit. Unset in development = log only (required)
NEWSLETTER_PROVIDER=resend
# Secret for signing confirmation links (32+ random characters, e.g. `openssl rand -base64 32`) (required)
NEWSLETTER_SECRET=
# Resend segment that new contacts join (provider=resend)
# → https://resend.com/audience → Segments
RESEND_SEGMENT_ID=
# Buttondown API key (provider=buttondown)
# → https://buttondown.com/settings/api
BUTTONDOWN_API_KEY=
# Kit (ConvertKit) v4 API key (provider=kit)
# → https://app.kit.com/account_settings/developer_settings
KIT_API_KEY=
# Kit form that subscribers are added to (provider=kit)
KIT_FORM_ID=

# ─── sentry ────────────────────────────────────────────────────────────────
# Project DSN. Unset = Sentry stays off
# → Sentry → Project settings → Client keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Build-time token to upload source maps (readable stack traces)
# → Sentry → Settings → Auth tokens (org:ci scope)
SENTRY_AUTH_TOKEN=
# Organization slug, for source map upload
SENTRY_ORG=
# Project slug, for source map upload
SENTRY_PROJECT=

# ─── store ─────────────────────────────────────────────────────────────────
# Signs download links (32+ random characters). Changing it invalidates links already sent (required)
# → openssl rand -base64 32
STORE_DOWNLOAD_SECRET=

# ─── uploads ───────────────────────────────────────────────────────────────
# S3-compatible endpoint. Unset in development → files are stored in .site/dev/uploads (required)
# → R2: dashboard → R2 → S3 API. AWS: https://s3.<region>.amazonaws.com
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Bucket region ("auto" for R2)
S3_REGION=auto
# Bucket name. Keep it private: downloads use short-lived signed URLs (required)
S3_BUCKET=my-site-uploads
# Access key with read/write on the bucket (required)
# → R2: Manage R2 API tokens → Object Read & Write. AWS: IAM user with s3:GetObject/PutObject/DeleteObject
S3_ACCESS_KEY_ID=
# Secret for the access key (required)
S3_SECRET_ACCESS_KEY=

# ─── waitlist ──────────────────────────────────────────────────────────────
# Bearer token for GET /api/waitlist/export (CSV). Leave unset to disable the export
WAITLIST_ADMIN_TOKEN=
